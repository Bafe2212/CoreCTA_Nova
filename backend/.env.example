# NOVA Backend — Beispiel-Konfiguration
# Kopiere diese Datei nach .env und trage deine Werte ein.

# MongoDB (im Docker-Compose-Setup wird MONGO_URL automatisch auf den mongo-Service gesetzt)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="nova"
CORS_ORIGINS="*"
# Öffentliche URL, unter der NOVA erreichbar ist.
APP_URL=http://localhost:3000

# --- LLM provider keys (nur serverseitig lesbar; mindestens einen setzen) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ZHIPUAI_API_KEY=
# International: https://api.z.ai/api/paas/v4/  |  China: https://open.bigmodel.cn/api/paas/v4/
ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4/
NOVA_DEFAULT_PROVIDER=openai

# --- ElevenLabs Text-to-Speech (optional, für natürliche Stimme) ---
# Ohne Key fällt NOVA auf die Browser-Sprachausgabe zurück.
# Voice-ID findest du im ElevenLabs-Dashboard oder via GET /api/tts/status.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
